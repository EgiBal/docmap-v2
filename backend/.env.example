# DocMap model config. Copy to .env and pick ONE preset. Keys are placeholders only.
# Three roles: LLM (name topic clusters, JSON), EMBED (chunks/topics), RERANK (optional).

# ---------- Preset: nim (NVIDIA build.nvidia.com) ----------
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY=nvapi-REPLACE_ME
# Reasoning model: code MUST send {"chat_template_kwargs":{"enable_thinking":false}} or content is empty.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false},"response_format":{"type":"json_object"}}

EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
EMBED_API_KEY=nvapi-REPLACE_ME
# Asymmetric model: "input_type" is REQUIRED (passage for chunks/topics, query for searches).
EMBED_INPUT_TYPE=1
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=
EMBED_BATCH=32

# Native NVIDIA rerank API (NOT OpenAI-shaped). Empty RERANK_URL = rerank off.
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
RERANK_API_KEY=nvapi-REPLACE_ME

# ---------- Preset: local (Ollama) ----------
